    "/v1/consume": {
      "post": {
        "operationId": "consume",
        "description": "Recheck all gates and atomically deduct once. Matching idempotent retry returns the original receipt.",
        "responses": {
          "200": {
            "description": "JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Validation, gate, authentication or service error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Validation, gate, authentication or service error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "409": {
            "description": "Validation, gate, authentication or service error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "Validation, gate, authentication or service error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "recipe_id",
                  "servings",
                  "expected_revision"
                ],
                "additionalProperties": false,
                "properties": {
                  "recipe_id": {
                    "type": "string"
                  },
                  "servings": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  },
                  "expected_revision": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 12,
              "maxLength": 128
            }
          }
        ]
      }
    },
    "/v1/lots/{lot_id}/review": {
      "post": {
        "operationId": "reviewLot",
        "description": "Revision-aware user correction of sourced label metadata, never quantities.",
        "responses": {
          "200": {
